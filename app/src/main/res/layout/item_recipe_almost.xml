<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the "Almost there" section (AlmostThereAdapter, Issue 27): the recipe's name and the one
    thing it lacks, "Missing: 2 pcs egg" or "Short: need 250 g flour, have 200 g". An outlined card on
    the surface-variant colour, so it can never be mistaken for a suggested row, which is plain on the
    list's surface. The whole card is the touch target that opens the recipe (Issue 25). Every text is
    set by the adapter.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:strokeColor="?attr/colorOutline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/list_item_two_line_min_height"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Spm.TitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Spm.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
