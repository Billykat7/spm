<?xml version="1.0" encoding="utf-8"?>
<!--
    The empty state every list shows instead of a blank screen: an illustration, a title saying what
    is missing and a button saying what to do. Included, never copied: the Pantry tab (Issue 13) and
    the suggested recipes (Issue 24) each <include> it with an id and set the title and the button
    label through the binding, so the layout carries no words of its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <ImageView
        android:id="@+id/empty_state_illustration"
        android:layout_width="@dimen/empty_state_illustration_size"
        android:layout_height="@dimen/empty_state_illustration_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ill_empty_pantry" />

    <ImageView
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:src="@drawable/ic_add" />

    <TextView
        android:id="@+id/empty_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Spm.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_state_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:minHeight="@dimen/touch_target_min" />

</LinearLayout>
