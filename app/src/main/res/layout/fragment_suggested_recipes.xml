<?xml version="1.0" encoding="utf-8"?>
<!--
    The Recipes tab (Issue 23): the recipes the pantry can make right now, or the shared state layout
    (Issue 30) in their place: its progress indicator while the first match runs, or a message for
    each EmptyReason with the "Add ingredients" button (Issue 24). SuggestedRecipesFragment shows
    exactly one of the list, the progress and the message, as RecipesRender decides. The state layout
    starts hidden, so the first frame flashes nothing, and its indicator waits before it appears, so
    a match that finishes quickly shows no spinner at all.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.recipes.SuggestedRecipesFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipe_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_s"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_recipe" />

    <include
        android:id="@+id/state_message"
        layout="@layout/view_state_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
