<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the pantry list (PantryAdapter): the name, the amount with its unit symbol, the expiry
    badge and the overflow button. A simple row, so a LinearLayout. The whole row is the touch target
    for opening the item (Issue 15), with its ripple drawn as a foreground so the row paints no
    background of its own over the list's; the overflow button opens Edit and Delete
    (menu/item_pantry_overflow.xml). Every text is set by the adapter from the item.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_two_line_min_height"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_s"
    android:paddingStart="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Spm.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Spm.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- The expiry badge: kept out of sight until Issue 17 gives it its text and colours -->
    <com.google.android.material.chip.Chip
        android:id="@+id/expiry_badge"
        style="@style/Widget.Material3.Chip.Assist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- The adapter replaces the description with one that names the item: "More options for Eggs" -->
    <ImageButton
        android:id="@+id/overflow"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/pantry_item_options"
        android:src="@drawable/ic_more_vert"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
