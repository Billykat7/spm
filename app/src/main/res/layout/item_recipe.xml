<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the suggested recipes (RecipeAdapter): the recipe's name, how many it serves and
    "You have all N ingredients", where N is the matcher's needCount. A simple row, so a LinearLayout.
    The whole row is the touch target that opens the recipe (Issue 25), its ripple drawn as a
    foreground. The servings line is gone for a recipe whose seed gives none. Every text is set by
    the adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_three_line_min_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Spm.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/servings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Spm.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/have_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Spm.BodyMedium"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
