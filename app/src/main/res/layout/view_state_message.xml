<?xml version="1.0" encoding="utf-8"?>
<!--
    The one layout for every screen's non-happy states (Issue 30): loading, empty and error. It has
    an illustration or a progress indicator, a headline, an optional body and an optional button,
    and no words of its own. Included, never copied: the Pantry tab (Issue 13), the Recipes tab
    (Issues 23, 24) and the recipe detail screen each <include> it as @id/state_message, and
    ui/StateMessage fills it, so a blank screen cannot happen and every state reads the same way.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <!-- Decorative: the headline says the same thing in words -->
    <ImageView
        android:id="@+id/state_illustration"
        android:layout_width="@dimen/empty_state_illustration_size"
        android:layout_height="@dimen/empty_state_illustration_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ill_empty_pantry" />

    <!--
        Loading only. It waits before it appears (showDelay), so work that finishes quickly shows no
        spinner, and stays long enough to be read once shown (minHideDelay)
    -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/state_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:minHideDelay="@integer/progress_min_hide_delay_ms"
        app:showDelay="@integer/progress_show_delay_ms" />

    <TextView
        android:id="@+id/state_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Spm.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Spm.BodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/state_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:minHeight="@dimen/touch_target_min"
        android:visibility="gone" />
</LinearLayout>
