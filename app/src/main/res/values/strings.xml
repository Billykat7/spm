<?xml version="1.0" encoding="utf-8"?>
<!--
    Every piece of text the user sees lives here: layouts and Java read it by name, never as a typed
    literal (Lint's HardcodedText and SetTextI18n are errors, see app/build.gradle). Punctuation and
    style follow docs/IDE/RULES/ui-text-punctuation.mdc: sentence case, no Oxford comma, a full stop
    on sentences and none on labels.
-->
<resources>
    <string name="app_name">Smart Pantry Manager</string>

    <!-- Bottom navigation tabs (Issue 3) -->
    <string name="tab_pantry">Pantry</string>
    <string name="tab_recipes">Recipes</string>
    <string name="tab_settings">Settings</string>

    <!--
        The Settings tab (Issue 28, res/xml/preferences.xml). Titles are labels, so no full stop;
        summaries are sentences. Each summary says what the setting does at its current value.
    -->
    <string name="settings_category_alerts">Alerts</string>
    <string name="settings_category_display">Display</string>
    <string name="settings_category_matching">Matching</string>
    <string name="settings_category_about">About</string>
    <string name="settings_expiry_alerts_title">Expiring-soon alerts</string>
    <string name="settings_expiry_alerts_on">A daily notification names the items about to expire.</string>
    <string name="settings_expiry_alerts_off">Off: no notification is posted.</string>
    <string name="settings_threshold_title">Expiring soon</string>
    <plurals name="settings_threshold_summary">
        <item quantity="one">Items expiring within %1$d day are badged and reported.</item>
        <item quantity="other">Items expiring within %1$d days are badged and reported.</item>
    </plurals>
    <string name="settings_send_test_alert_title">Send a test alert now</string>
    <string name="settings_send_test_alert_summary">Check the pantry now and post the alert if anything is expiring.</string>
    <string name="settings_expiry_alerts_on_blocked">On, but this app may not post notifications, so nothing is shown.</string>
    <string name="settings_expiry_alerts_off_blocked">Off: notifications are not allowed for this app.</string>
    <string name="settings_notification_settings_title">Notification settings</string>
    <string name="settings_notification_settings_summary">Allow this app\'s notifications in the system settings.</string>
    <string name="notification_rationale_title">Allow notifications?</string>
    <string name="notification_rationale_message">The expiring-soon alert is a notification. Without permission to post one, the alert stays off.</string>
    <string name="action_continue">Continue</string>
    <string name="action_not_now">Not now</string>
    <string name="settings_units_title">Units</string>
    <string name="settings_units_metric">Metric (g, kg, ml, l)</string>
    <string name="settings_units_imperial">Imperial (oz, fl oz)</string>
    <string name="settings_count_expired_title">Count expired items</string>
    <string name="settings_count_expired_on">Expired items count when recipes are matched, as if they were fresh.</string>
    <string name="settings_count_expired_off">Expired items are left out when recipes are matched.</string>
    <string name="settings_version_title">Version</string>
    <string name="settings_repository_title">Source code</string>
    <string name="settings_repository_summary">Open the project\'s repository on GitHub.</string>
    <string name="settings_no_browser">No app on this device can open the link.</string>
    <!--
        The expiring-soon notification (Issue 29, notifications/ResourceExpiryTexts). The title is a
        label, the body a list: "tomato (tomorrow), milk (in 3 days) and 2 more". The separator keeps
        its space, so it is quoted.
    -->
    <plurals name="expiry_alert_title">
        <item quantity="one">%1$d item expiring soon</item>
        <item quantity="other">%1$d items expiring soon</item>
    </plurals>
    <string name="expiry_alert_today">today</string>
    <string name="expiry_alert_tomorrow">tomorrow</string>
    <plurals name="expiry_alert_in_days">
        <item quantity="one">in %1$d day</item>
        <item quantity="other">in %1$d days</item>
    </plurals>
    <plurals name="expiry_alert_expired_ago">
        <item quantity="one">expired %1$d day ago</item>
        <item quantity="other">expired %1$d days ago</item>
    </plurals>
    <string name="expiry_alert_item">%1$s (%2$s)</string>
    <string name="expiry_alert_separator">", "</string>
    <plurals name="expiry_alert_and_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>
    <string name="expiry_channel_name">Expiring-soon alerts</string>
    <string name="expiry_channel_description">A daily reminder of the pantry items about to expire.</string>

    <!-- Not text: where "Source code" goes -->
    <string name="repository_url" translatable="false">https://github.com/Billykat7/spm</string>

    <!-- The pantry list (Issue 13) -->
    <string name="pantry_empty_title">Your pantry is empty</string>
    <string name="action_add_ingredient">Add ingredient</string>
    <string name="pantry_item_options">More options</string>
    <string name="pantry_item_options_for">More options for %1$s</string>
    <!-- What TalkBack says for a whole pantry row (Issue 30): name, amount in words, then the badge -->
    <string name="pantry_row_description">%1$s, %2$s, %3$s</string>
    <string name="pantry_row_description_no_expiry">%1$s, %2$s</string>
    <string name="action_edit">Edit</string>
    <string name="action_delete">Delete</string>
    <string name="action_cancel">Cancel</string>

    <!-- The Pantry tab's sort menu (Issue 17); the en dash in A–Z marks a range -->
    <string name="sort_by">Sort by</string>
    <string name="cd_sort_pantry">Sort the pantry</string>
    <string name="sort_expiry_soonest">Expiry (soonest first)</string>
    <string name="sort_name">Name (A–Z)</string>

    <!--
        The expiry badge on a pantry row (Issue 17), from ui/pantry/ExpiryBadgeFormatter. Labels, so
        no full stop. Counts go through plurals: "Expires in 1 day", never "1 days".
    -->
    <plurals name="expiry_badge_expires_in">
        <item quantity="one">Expires in %1$d day</item>
        <item quantity="other">Expires in %1$d days</item>
    </plurals>
    <string name="expiry_badge_expires_today">Expires today</string>
    <plurals name="expiry_badge_expired_ago">
        <item quantity="one">Expired %1$d day ago</item>
        <item quantity="other">Expired %1$d days ago</item>
    </plurals>

    <!--
        The Recipes tab (Issue 23). The title counts only the recipes that can be made now, never the
        almost-there ones; a plurals resource, so a language whose count changes the words can say so.
    -->
    <plurals name="suggested_recipes_title">
        <item quantity="one">Suggested recipes (%1$d)</item>
        <item quantity="other">Suggested recipes (%1$d)</item>
    </plurals>
    <string name="recipe_serves">Serves %1$d</string>
    <plurals name="recipe_have_all_ingredients">
        <item quantity="one">You have the %1$d ingredient</item>
        <item quantity="other">You have all %1$d ingredients</item>
    </plurals>
    <string name="recipes_loading">Matching recipes to your pantry</string>
    <!--
        Why the Recipes tab has nothing to suggest (Issue 24, ui/recipes/EmptyReason). One-line
        messages, so no full stop; the brief's dash is a comma here. NO_MATCH is the brief's own
        sentence (2.2), word for word.
    -->
    <string name="recipes_empty_no_match">No recipes match your pantry yet, add more ingredients</string>
    <string name="recipes_empty_pantry_empty">Your pantry is empty, add some ingredients to see what you can cook</string>
    <string name="recipes_empty_no_recipes">The recipe collection did not load, reinstall the app to restore it</string>
    <string name="recipes_empty_action">Add ingredients</string>

    <!--
        The "Almost there" section (Issue 27), kept apart from the suggestions: its heading, and the one
        line each row gives from MatchResult.missingOne(). Quantity first, then the name: "2 pcs egg".
    -->
    <string name="almost_there_heading">Almost there (missing one ingredient)</string>
    <string name="almost_missing">Missing: %1$s %2$s</string>
    <string name="almost_short">Short: need %1$s %2$s, have %3$s</string>

    <!--
        The recipe detail screen (Issue 25). The status line and each ingredient's mark come from the
        matcher's result; "need ..., have ..." puts the recipe's amount first and the pantry's second.
    -->
    <string name="title_recipe_detail">Recipe</string>
    <string name="recipe_not_found">Recipe not found</string>
    <string name="recipe_loading">Loading the recipe</string>
    <string name="recipe_can_make">You can make this</string>
    <plurals name="recipe_missing_ingredients">
        <item quantity="one">Missing %1$d ingredient</item>
        <item quantity="other">Missing %1$d ingredients</item>
    </plurals>
    <string name="ingredient_have">You have this</string>
    <string name="ingredient_need">You need this</string>
    <string name="ingredient_need_have">need %1$s, have %2$s</string>
    <string name="ingredient_need_have_none">need %1$s, have none</string>
    <string name="recipe_method">Method</string>
    <!-- A step's number in the method: 1., 2., 3. -->
    <string name="recipe_step_number">%1$d.</string>

    <!-- Deleting an ingredient (Issue 16): the confirmation, then the Snackbar that can undo it -->
    <string name="delete_confirm_title">Delete %1$s?</string>
    <string name="delete_confirm_message">This removes it from your pantry.</string>
    <string name="deleted_item">Deleted %1$s</string>
    <string name="action_undo">Undo</string>

    <!-- The add and edit ingredient screen (Issues 13 to 15) -->
    <string name="title_add_ingredient">Add ingredient</string>
    <string name="title_edit_ingredient">Edit ingredient</string>
    <string name="ingredient_not_found">Ingredient not found</string>
    <string name="action_save">Save</string>
    <string name="label_name">Name</string>
    <string name="label_quantity">Quantity</string>
    <string name="label_unit">Unit</string>
    <string name="label_expiry">Expiry date (optional)</string>
    <string name="helper_expiry">Leave it empty if the ingredient does not expire.</string>
    <string name="cd_choose_expiry">Choose expiry date</string>
    <string name="cd_clear_expiry">Clear expiry date</string>
    <string name="expiry_picker_title">Expiry date</string>
    <string name="ingredient_saved">Ingredient saved</string>
    <!-- Not text: the characters the quantity field lets through, both decimal separators included -->
    <string name="quantity_accepted_characters" translatable="false">0123456789.,</string>

    <!--
        Why an ingredient cannot be saved (domain/validation/Validators, Issue 14). Each says what to
        do. The numbers repeat Validators.MAX_NAME_LENGTH and MAX_QUANTITY; ValidatorsTest checks them.
    -->
    <string name="error_name_required">Name is required.</string>
    <string name="error_name_too_long">Name must be 60 characters or fewer.</string>
    <string name="error_quantity_required">Enter a quantity.</string>
    <string name="error_quantity_not_a_number">Enter a number, such as 4 or 1.5.</string>
    <string name="error_quantity_not_positive">Quantity must be more than 0.</string>
    <string name="error_quantity_too_large">Quantity must be 100000 or less.</string>
    <string name="error_unit_required">Choose a unit.</string>
    <string name="error_expiry_in_past">Expiry date cannot be in the past.</string>

    <!--
        Unit symbols as shown on screen, after a number and a non-breaking space (250 g). One per
        domain.Unit constant; the enum points at these through Unit.symbolRes().
    -->
    <string name="unit_g">g</string>
    <string name="unit_kg">kg</string>
    <string name="unit_ml">ml</string>
    <string name="unit_l">l</string>
    <string name="unit_tsp">tsp</string>
    <string name="unit_tbsp">tbsp</string>
    <string name="unit_cup">cup</string>
    <string name="unit_pcs">pcs</string>
    <!--
        Display-only symbols for the imperial units preference (Issue 19): domain.DisplayUnit points at
        these. They are never stored and never matched. A non-breaking space keeps "fl oz" on one line.
    -->
    <string name="unit_oz">oz</string>
    <string name="unit_fl_oz">fl\u00A0oz</string>

    <!--
        Each unit in full, for a screen reader (Issue 30, util/SpokenQuantity): TalkBack reads "pcs" as
        "p c s". The amount is already formatted for the locale, so it is a string, not a number.
    -->
    <plurals name="unit_spoken_g">
        <item quantity="one">%1$s gram</item>
        <item quantity="other">%1$s grams</item>
    </plurals>
    <plurals name="unit_spoken_kg">
        <item quantity="one">%1$s kilogram</item>
        <item quantity="other">%1$s kilograms</item>
    </plurals>
    <plurals name="unit_spoken_ml">
        <item quantity="one">%1$s millilitre</item>
        <item quantity="other">%1$s millilitres</item>
    </plurals>
    <plurals name="unit_spoken_l">
        <item quantity="one">%1$s litre</item>
        <item quantity="other">%1$s litres</item>
    </plurals>
    <plurals name="unit_spoken_tsp">
        <item quantity="one">%1$s teaspoon</item>
        <item quantity="other">%1$s teaspoons</item>
    </plurals>
    <plurals name="unit_spoken_tbsp">
        <item quantity="one">%1$s tablespoon</item>
        <item quantity="other">%1$s tablespoons</item>
    </plurals>
    <plurals name="unit_spoken_cup">
        <item quantity="one">%1$s cup</item>
        <item quantity="other">%1$s cups</item>
    </plurals>
    <plurals name="unit_spoken_pcs">
        <item quantity="one">%1$s piece</item>
        <item quantity="other">%1$s pieces</item>
    </plurals>
    <plurals name="unit_spoken_oz">
        <item quantity="one">%1$s ounce</item>
        <item quantity="other">%1$s ounces</item>
    </plurals>
    <plurals name="unit_spoken_fl_oz">
        <item quantity="one">%1$s fluid ounce</item>
        <item quantity="other">%1$s fluid ounces</item>
    </plurals>

    <!-- An amount and its unit symbol, joined by a non-breaking space so they never wrap apart: 250 g -->
    <string name="quantity_with_unit">%1$s\u00A0%2$s</string>
</resources>
