<?xml version="1.0" encoding="utf-8"?>
<!--
    Every piece of text the user sees lives here: layouts and Java read it by name, never as a typed
    literal (Lint's HardcodedText and SetTextI18n are errors, see app/build.gradle). Punctuation and
    style follow docs/IDE/RULES/ui-text-punctuation.mdc: sentence case, no Oxford comma, a full stop
    on sentences and none on labels.
-->
<resources>
    <string name="app_name">Smart Pantry Manager</string>

    <!-- Bottom navigation tabs (Issue 3) -->
    <string name="tab_pantry">Pantry</string>
    <string name="tab_recipes">Recipes</string>
    <string name="tab_settings">Settings</string>

    <!-- Tab placeholders, until Issues 23 and 28 fill each tab -->
    <string name="placeholder_recipes_title">Suggested recipes</string>
    <string name="placeholder_recipes_body">Recipes you can cook with what is in your pantry will appear here.</string>
    <string name="placeholder_settings_title">Your preferences</string>
    <string name="placeholder_settings_body">Expiring-soon alerts, units and matching options will be set here.</string>

    <!-- The pantry list (Issue 13) -->
    <string name="pantry_empty_title">Your pantry is empty</string>
    <string name="action_add_ingredient">Add ingredient</string>
    <string name="pantry_item_options">More options</string>
    <string name="pantry_item_options_for">More options for %1$s</string>
    <string name="action_edit">Edit</string>
    <string name="action_delete">Delete</string>
    <string name="action_cancel">Cancel</string>

    <!-- The Pantry tab's sort menu (Issue 17); the en dash in A–Z marks a range -->
    <string name="sort_by">Sort by</string>
    <string name="cd_sort_pantry">Sort the pantry</string>
    <string name="sort_expiry_soonest">Expiry (soonest first)</string>
    <string name="sort_name">Name (A–Z)</string>

    <!--
        The expiry badge on a pantry row (Issue 17), from ui/pantry/ExpiryBadgeFormatter. Labels, so
        no full stop. Counts go through plurals: "Expires in 1 day", never "1 days".
    -->
    <plurals name="expiry_badge_expires_in">
        <item quantity="one">Expires in %1$d day</item>
        <item quantity="other">Expires in %1$d days</item>
    </plurals>
    <string name="expiry_badge_expires_today">Expires today</string>
    <plurals name="expiry_badge_expired_ago">
        <item quantity="one">Expired %1$d day ago</item>
        <item quantity="other">Expired %1$d days ago</item>
    </plurals>

    <!-- Deleting an ingredient (Issue 16): the confirmation, then the Snackbar that can undo it -->
    <string name="delete_confirm_title">Delete %1$s?</string>
    <string name="delete_confirm_message">This removes it from your pantry.</string>
    <string name="deleted_item">Deleted %1$s</string>
    <string name="action_undo">Undo</string>

    <!-- The add and edit ingredient screen (Issues 13 to 15) -->
    <string name="title_add_ingredient">Add ingredient</string>
    <string name="title_edit_ingredient">Edit ingredient</string>
    <string name="ingredient_not_found">Ingredient not found</string>
    <string name="action_save">Save</string>
    <string name="label_name">Name</string>
    <string name="label_quantity">Quantity</string>
    <string name="label_unit">Unit</string>
    <string name="label_expiry">Expiry date (optional)</string>
    <string name="helper_expiry">Leave it empty if the ingredient does not expire.</string>
    <string name="cd_choose_expiry">Choose expiry date</string>
    <string name="cd_clear_expiry">Clear expiry date</string>
    <string name="expiry_picker_title">Expiry date</string>
    <string name="ingredient_saved">Ingredient saved</string>
    <!-- Not text: the characters the quantity field lets through, both decimal separators included -->
    <string name="quantity_accepted_characters" translatable="false">0123456789.,</string>

    <!--
        Why an ingredient cannot be saved (domain/validation/Validators, Issue 14). Each says what to
        do. The numbers repeat Validators.MAX_NAME_LENGTH and MAX_QUANTITY; ValidatorsTest checks them.
    -->
    <string name="error_name_required">Name is required.</string>
    <string name="error_name_too_long">Name must be 60 characters or fewer.</string>
    <string name="error_quantity_required">Enter a quantity.</string>
    <string name="error_quantity_not_a_number">Enter a number, such as 4 or 1.5.</string>
    <string name="error_quantity_not_positive">Quantity must be more than 0.</string>
    <string name="error_quantity_too_large">Quantity must be 100000 or less.</string>
    <string name="error_unit_required">Choose a unit.</string>
    <string name="error_expiry_in_past">Expiry date cannot be in the past.</string>

    <!--
        Unit symbols as shown on screen, after a number and a non-breaking space (250 g). One per
        domain.Unit constant; the enum points at these through Unit.symbolRes().
    -->
    <string name="unit_g">g</string>
    <string name="unit_kg">kg</string>
    <string name="unit_ml">ml</string>
    <string name="unit_l">l</string>
    <string name="unit_tsp">tsp</string>
    <string name="unit_tbsp">tbsp</string>
    <string name="unit_cup">cup</string>
    <string name="unit_pcs">pcs</string>

    <!-- An amount and its unit symbol, joined by a non-breaking space so they never wrap apart: 250 g -->
    <string name="quantity_with_unit">%1$s\u00A0%2$s</string>
</resources>
