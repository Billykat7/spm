<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's spacing, touch-target and corner sizes. Layouts take padding and margins from these
    steps rather than typing a dp value, so every screen keeps the same rhythm.
-->
<resources>
    <!-- Spacing steps on a 4 dp grid: between related items, between groups, screen edges -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>

    <!-- The decorative icon above a placeholder or empty state -->
    <dimen name="placeholder_icon_size">64dp</dimen>

    <!-- The illustration at the top of an empty state (view_empty_state.xml) -->
    <dimen name="empty_state_illustration_size">160dp</dimen>

    <!-- A list row with a title and a supporting line, as Material 3's two-line list item -->
    <dimen name="list_item_two_line_min_height">72dp</dimen>

    <!-- A list row with a title and two supporting lines, as Material 3's three-line list item -->
    <dimen name="list_item_three_line_min_height">88dp</dimen>

    <!-- Space under the last row of a list with a FAB: the FAB's 56 dp and its 16 dp margins -->
    <dimen name="list_bottom_space_for_fab">88dp</dimen>

    <!-- The smallest tappable area, from the Android accessibility guidelines -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Corner radius of cards, dialogs and other medium components (Material 3's medium shape) -->
    <dimen name="corner_radius_medium">12dp</dimen>
</resources>
