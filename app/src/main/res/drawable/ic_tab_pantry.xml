<?xml version="1.0" encoding="utf-8"?>
<!--
    The Pantry tab's icon: filled while its tab is selected, outlined otherwise, as the
    Material 3 navigation bar specifies. The bottom navigation sets the checked state.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_tab_pantry_filled" android:state_checked="true" />
    <item android:drawable="@drawable/ic_tab_pantry_outlined" />
</selector>
