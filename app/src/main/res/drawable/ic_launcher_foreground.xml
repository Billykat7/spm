<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a pantry jar with an amber lid and a leaf on its front. Everything sits
    inside the 66 dp safe zone centred in the 108 dp canvas, so no launcher mask (circle, squircle,
    teardrop) clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lid -->
    <path
        android:fillColor="@color/ic_launcher_lid"
        android:pathData="M38,30h32a3,3 0,0 1,3 3v4a3,3 0,0 1,-3 3h-32a3,3 0,0 1,-3 -3v-4a3,3 0,0 1,3 -3z" />
    <!-- Jar -->
    <path
        android:fillColor="@color/ic_launcher_jar"
        android:pathData="M43,42h22a9,9 0,0 1,9 9v20a9,9 0,0 1,-9 9h-22a9,9 0,0 1,-9 -9v-20a9,9 0,0 1,9 -9z" />
    <!-- Leaf -->
    <path
        android:fillColor="@color/ic_launcher_leaf"
        android:pathData="M54,48C66,60 63,71 54,74C45,71 42,60 54,48Z" />
    <!-- Leaf vein -->
    <path
        android:pathData="M54,56L54,71"
        android:strokeWidth="1.5"
        android:strokeColor="@color/ic_launcher_jar"
        android:strokeLineCap="round" />
</vector>
