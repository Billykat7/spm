<?xml version="1.0" encoding="utf-8"?>
<!--
    Empty-state illustration for the pantry list: the app icon's jar, standing open and empty on a
    shelf with its amber lid lifted off. Drawn for this app, no third-party artwork. Every colour is a
    theme role, so the picture follows light and dark mode with the rest of the screen. Decorative: the
    ImageView that shows it is hidden from accessibility, the title beside it says the same thing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="160"
    android:viewportHeight="160">
    <!-- Backdrop -->
    <path
        android:fillColor="?attr/colorSurfaceContainerHigh"
        android:pathData="M80,8a72,72 0,1 1,0 144a72,72 0,1 1,0 -144z" />
    <!-- Shelf -->
    <path
        android:fillColor="?attr/colorOutlineVariant"
        android:pathData="M27,118h106a3,3 0,0 1,3 3v2a3,3 0,0 1,-3 3h-106a3,3 0,0 1,-3 -3v-2a3,3 0,0 1,3 -3z" />
    <!-- Jar neck -->
    <path
        android:fillColor="?attr/colorSurface"
        android:pathData="M62,50h36v10h-36z"
        android:strokeWidth="4"
        android:strokeColor="?attr/colorPrimary"
        android:strokeLineJoin="round" />
    <!-- Jar body, empty -->
    <path
        android:fillColor="?attr/colorSurface"
        android:pathData="M64,60h32a12,12 0,0 1,12 12v34a12,12 0,0 1,-12 12h-32a12,12 0,0 1,-12 -12v-34a12,12 0,0 1,12 -12z"
        android:strokeWidth="4"
        android:strokeColor="?attr/colorPrimary"
        android:strokeLineJoin="round" />
    <!-- Highlight on the glass -->
    <path
        android:pathData="M62,74v24"
        android:strokeWidth="4"
        android:strokeAlpha="0.35"
        android:strokeColor="?attr/colorPrimary"
        android:strokeLineCap="round" />
    <!-- Lid, lifted off and tilted -->
    <group
        android:pivotX="80"
        android:pivotY="36"
        android:rotation="-14"
        android:translateX="6">
        <path
            android:fillColor="?attr/colorSecondary"
            android:pathData="M59,30h42a3,3 0,0 1,3 3v6a3,3 0,0 1,-3 3h-42a3,3 0,0 1,-3 -3v-6a3,3 0,0 1,3 -3z" />
    </group>
</vector>
