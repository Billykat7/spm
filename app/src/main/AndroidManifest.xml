<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The expiring-soon alert (Issue 29). A runtime permission from Android 13 (API 33), asked for
        by the Settings tab when the alert is turned on; below 33 it is granted at install. The app's
        only permission: no location, no network (scripts/check_guards.sh).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SpmApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spm"
        tools:targetApi="33">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Opened only by AddEditIngredientActivity.intentForAdd, an explicit Intent, so not exported.
            adjustResize: the keyboard's inset reaches the form, which pads itself clear of it
        -->
        <activity
            android:name=".ui.pantry.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <!--
            Opened only by RecipeDetailActivity.intentFor, an explicit Intent carrying the recipe's id,
            so not exported. Up and Back both close it, back to the Recipes tab it was opened from.
        -->
        <activity
            android:name=".ui.recipes.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".ui.MainActivity" />
    </application>

</manifest>
