<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SpmApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spm"
        tools:targetApi="33">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Opened only by AddEditIngredientActivity.intentForAdd, an explicit Intent, so not exported.
            adjustResize: the keyboard's inset reaches the form, which pads itself clear of it
        -->
        <activity
            android:name=".ui.pantry.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
