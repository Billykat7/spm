# Android Studio project .gitignore (root), extended for this repository.

# Gradle
.gradle/
build/
/captures
.externalNativeBuild
.cxx

# The Gradle wrapper jar is committed, whatever a global ignore says about *.jar
!gradle/wrapper/gradle-wrapper.jar

# Local SDK path and machine-specific settings
local.properties

# IDE: IntelliJ / Android Studio. Shared code-style files are kept.
*.iml
.idea/*
!.idea/codeStyles/
.DS_Store

# Build outputs
*.apk
*.aab
*.dex
*.class

# Signing material is never committed
*.keystore
*.jks

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# Submission secrets (student number), see docs/IDE/RULES/student-number-never-committed.mdc
.submission.env
